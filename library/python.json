            "        kari = 1 << (self.bitlen-1)",
            "        for _ in range(self.bitlen):",
            "            if x & kari:",
            "                num += self.cnt[self.nodes[pt]]",
            "                pt = self.nodes[pt] + 1",
            "            else:",
            "                pt = self.nodes[pt]",
            "            if self.nodes[pt] == -1:",
            "                break",
            "            kari = kari >> 1",
            "        return num+1",
            "",
            "    #xより大きい数のうち最小の要素の番号を得る",
