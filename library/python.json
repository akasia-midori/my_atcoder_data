    "wa-syaru_huroido_hukugen": {
        "prefix": "wa-syaru_huroido_hukugen",
        "body": [
            "#入力",
            "INF = sys.maxsize",
            "cost = [[INF]*N for i in range(N)]",
            "nexts = [[INF]*N for i in range(N)]",
            "for y in range(N):",
            "    for x,m in enumerate(mi()):",
            "        cost[y][x]=m",
            "        nexts[y][x]=x",
            "",
            "# cost[i][j]: 頂点v_iから頂点v_jへ到達するための辺コストの和",
            "use_set = {i:{j:set([]) for j in range(i+1,N)} for i in range(N-1)}",
            "for k in range(N):",
            "    for i in range(N):",
            "        for j in range(i+1,N):",
            "            a,b = sorted([i, j])",
            "            if cost[i][k]!=INF and cost[k][j]!=INF:",
            "                if cost[i][j] > cost[i][k] + cost[k][j]:",
            "                    cost[i][j] = cost[i][k] + cost[k][j]",
            "                    nexts[i][j] = nexts[k][j]",
            "                    ",
            "def get_path(s, t):",
            "    global nexts",
            "    global cost",
            "    global v",
            "    cur = s",
            "    ret = []",
            "    ",
            "    while cur != t:",
            "        ret.append(cur)",
            "        cur = nexts[cur][t]",
            "        ",
            "    ret.append(t)",
            "    return ret",
        ],
