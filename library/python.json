    "ERATOSUTENESU": {
        "prefix": "ERATOSUTENESU",
        "body": [
            "# エラトステネスの篩",
            "# 用意してないよ",
            "# 重要な点 : 掛け算で追う形は計算量が思ったより少ないよ",
            "# O(N * logN)",
            "import math",
            "for K in range(1, 8):",
            "    N = 10**K",
            "    count = 0",
            "    for i in range(1,N+1):",
            "        for j in range(i, N+1, i):",
            "            count += 1",
            "    print(N, count, math.log(N), count/N)",
            "",
            "# 多くの素因数分解をするならこっち",
            "class Eratosthenes:",
            "    # 線形篩のマネごとをタダのエラトステネスの篩で行う(この方が線形篩より速い)",
            "    def __init__(self, N):",
            "        # テーブル",
            "        self.isprime = [0] * (N+1)",
            "",
            "        # 0, 1 は予めふるい落としておく",
            "        self.isprime[0], self.isprime[1] = None, None",
            "",
            "        # ふるい",
            "        for p in range(2, N+1):",
            "            # すでに合成数であるものはスキップする",
            "            if self.isprime[p] != 0: continue",
            "",
            "            self.isprime[p] = p",
            "            # p 以外の p の倍数から素数ラベルを剥奪",
            "            q = p + p",
            "            while q <= N:",
            "                if self.isprime[q] == 0: self.isprime[q] = p",
            "                q += p",
            "    ",
            "    # osa_k法で素因数分解をO(logN)で行う",
            "    def factorization(self, N):",
            "        out = [[self.isprime[N], 1]]",
            "        next = N//self.isprime[N]",
            "        # Nが素数だったら終わり",
            "        if N == self.isprime[N]:",
            "            return out",
            "",
            "        que = [next]",
            "        # print(que, next,out)",
            "        while que:",
            "            num = que.pop()",
            "            if self.isprime[num] == out[-1][0]: # すでに存在している素因数と等しければ",
            "                out[-1][1] += 1",
            "            else:",
            "                out.append([self.isprime[num], 1])",
            "            ",
            "            next = num//self.isprime[num]",
            "            if num != self.isprime[num]:",
            "                que.append(next)",
            "        return out",
        ],
        "description": ""
    },

