            "    # lからrの中で出現頻度の多い数値を上位k個取り出す、種類が足りない場合は途中で打ち切る",
            "    def topk(self, org_l, org_r, k):",
            "        q1 = [((org_r-org_l), org_l, 0)]",
            "",
            "        for i in range(self.bit_length):",
            "            q2 = []",
            "            while q1:",
            "                haba, l, num = q1.pop()",
