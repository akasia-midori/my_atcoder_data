            "    def kth_sum(self, k, xorval=0):",
            "        val = 0",
            "        pt = 0",
            "        kari = 1 << (self.bitlen-1)",
            "        temp = 0",
            "        for _ in range(self.bitlen):",
            "            if k > self.cnt[self.nodes[pt]]:",
            "                k -= self.cnt[self.nodes[pt]]",
            "                temp += self.sum[self.nodes[pt]]",
            "                pt = self.nodes[pt] + 1",
            "                val += kari",
            "            else:",
            "                pt = self.nodes[pt]",
            "            if self.nodes[pt] == -1:",
            "                break",
            "            kari = kari >> 1",
