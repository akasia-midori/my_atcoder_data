            "# 入力値取得",
            "# https://qiita.com/kindamu24005/items/3b6687136838c16caee6",
            "V,E=map(int,input().split())",
            "",
            "inf=float(\"inf\")",
            "",
            "# 隣接行列Aを作る",
            "A=[[inf]*V for i in range(V)]",
            "for i in range(E):",
            "  s,t,d=map(int,input().split())",
            "  A[s][t]=d",
            "",
            "# dp表を作る",
            "dp=[[inf]*V for i in range(2**V)]",
            "   ",
            "# 初期値を入れる ",
            "dp[0][0]=0",
            "    ",
            "# 空({∅})の時を除いた頂点集合で回す",
            "for i in range(1,2**V):",
            "  # 移動後の頂点で回す",
            "  for j1 in range(V):",
            "    # 移動前の頂点で回す",
            "    for j2 in range(V):",
            "      # 「移動後の頂点が頂点集合に含まれている」かつ「移動後と移動前の頂点が同じでない」かつ「移動後と移動前の頂点が隣接している」かを判断",
            "      if i>>j1 & 1 and not j1==j2 and not A[j2][j1]==inf:",
            "          dp[i][j1] = min(dp[i][j1],dp[i^(1<<j1)][j2]+A[j2][j1])",
            "    ",
            "if not dp[2**V-1][0]==inf:",
            "  print(dp[2**V-1][0])",
            "# 条件を満たす経路がない場合",
            "else:",
            "  print(-1)",
            "",
        ],
        "description": ""
    },
    "merge_sort": {
        "prefix": "merge_sort",
        "body": [
            "",
            "def sort_func(A,B):",
            "    Ax, Bx, indx = A",
            "    Ay, By, indy = B",
            "",
            "    AA = (Ax)*(Ay+By) ",
            "    BB = (Ay)*(Ax+Bx) ",
            "    if AA < BB:",
            "        return True",
            "    elif AA > BB:",
            "        return False",
            "    else:",
            "        if indx > indy:",
            "            return True",
            "        elif indx < indy:",
            "            return False",
            "            ",
            "def merge_sort(arr):",
            "    if len(arr) <= 1:",
            "        return arr",
            "    ",
            "    # 初期段階では、配列の各要素が個々のソート済み部分とみなされる",
            "    width = 1",
            "    n = len(arr)",
            "    ",
            "    # width を2倍に増やしながら各幅でのマージを繰り返す",
            "    while width < n:",
            "        for i in range(0, n, 2 * width):",
            "            left = arr[i:i + width]",
            "            right = arr[i + width:i + 2 * width]",
            "            arr[i:i + 2 * width] = merge(left, right)",
            "        width *= 2",
            "    ",
            "    return arr",
            "",
            "def merge(left, right):",
            "    result = []",
            "    i = j = 0",
            "",
            "    # 両方のリストに要素が残っている間ループ",
            "    while i < len(left) and j < len(right):",
            "        if sort_func(left[i], right[j]):",
            "            result.append(left[i])",
            "            i += 1",
            "        else:",
            "            result.append(right[j])",
            "            j += 1",
            "",
            "    # 残っている要素を結果リストに追加",
            "    result.extend(left[i:])",
            "    result.extend(right[j:])",
            "",
            "    return result",
            "",
            "N = oi()",
            "output = []",
            "for i in range(N):",
            "    A,B = mi()",
            "    output.append((A,B,i))",
            "    ",
            "# 使用例",
            "sorted_arr = merge_sort(output)",
        ],
        "description": ""
    },
    "ZENHOUIGIDP": {
        "prefix": "ZENHOUIGIDP",
        "body": [
            "# kiriさんの全方位木dpを借りパクしております",
            "# https://qiita.com/Kiri8128/items/a011c90d25911bdb3ed3",
            "# 全方位木DP",
            "import sys",
            "input = sys.stdin.readline",
            "from collections import deque",
            "",
            "N, mod = map(int, input().split())",
            "X = [[] for i in range(N)]",
            "for i in range(N-1):",
            "    x, y = map(int, input().split())",
            "    X[x-1].append(y-1)",
            "    X[y-1].append(x-1)",
            "",
            "P = [-1] * N",
            "Q = deque([0])",
            "R = []",
            "",
            "# トポロジカルソート",
            "while Q:",
            "    i = deque.popleft(Q)",
            "    R.append(i)",
            "    for a in X[i]:",
            "        if a != P[i]:",
            "            P[a] = i",
            "            X[a].remove(i)",
            "            deque.append(Q, a)",
            "",
            "##### Settings",
            "unit = 1",
            "merge = lambda a, b: a * b % mod",
            "adj_bu = lambda a, i: a + 1",
            "adj_td = lambda a, i, p: a + 1",
            "adj_fin = lambda a, i: a",
            "#####",
            "",
            "########################## 逆順ソート ##############################",
            "ME = [unit] * N",
            "XX = [0] * N",
            "TD = [unit] * N",
            "for i in R[1:][::-1]:",
            "    XX[i] = adj_bu(ME[i], i)",
            "    p = P[i]",
            "    ME[p] = merge(ME[p], XX[i])",
            "XX[R[0]] = adj_fin(ME[R[0]], R[0])",
            "",
            "# print(\"ME =\", ME) # Merge before adj",
            "# print(\"XX =\", XX) # Bottom-up after adj",
            "",
            "########################## 正順ソート ############################## ",
            "for i in R:",
            "    ac = TD[i]",
            "    for j in X[i]:",
            "        TD[j] = ac",
            "        ac = merge(ac, XX[j])",
            "    ac = unit",
            "    for j in X[i][::-1]:",
            "        TD[j] = adj_td(merge(TD[j], ac), j, i)",
            "        ac = merge(ac, XX[j])",
            "        XX[j] = adj_fin(merge(ME[j], TD[j]), j)",
            "",
            "# print(\"TD =\", TD) # Top-down after adj",
            "# print(\"XX =\", XX) # Final Result",
            "",
            "",
        ],
        "description": ""
    },
    "renketu_list": {
        "prefix": "renketu_list",
        "body": [
            "class node:",
            "    def __init__(self, v):",
            "        self.v = v",
            "        self.left = None",
            "        self.right = None",
            "def insert(now_node, nodes):",
            "    if now_node.right is None:",
            "        now_node.right = nodes",
            "        now_node.right.left = now_node",
            "    else:",
            "        #      now",
            "        #             right",
            "        #       ↓",
            "        # ",
            "        #       nodes ",
            "        # now          right",
            "        #",
            "        # 変えるもの",
            "        # now.right",
            "        # right.left",
            "        # nodes.right",
            "        # nodes.left",
            "",
            "        right = now_node.right",
            "        now_node.right = nodes # now.right ",
            "        right.left = nodes # right.left",
            "",
            "        nodes.right = right # nodes.right ",
            "        nodes.left = now_node # nodes.left ",
            "",
            "",
            "def delete(dicts, v):",
            "    temp = dicts[v]",
            "    l = temp.left",
            "    r = temp.right",
            "    if l is not None:",
            "        l.right = r",
            "    if r is not None:",
            "        r.left = l",
            "    del dicts[v]",
            "    return dicts",
        ],
        "description": ""
    },
    "TATAMIKOMI": {
        "prefix": "TATAMIKOMI",
        "body": [
            "# https://maspypy.com/%E6%95%B0%E5%AD%A6%E3%83%BBnumpy-%E9%AB%98%E9%80%9F%E3%83%95%E3%83%BC%E3%83%AA%E3%82%A8%E5%A4%89%E6%8F%9Bfft%E3%81%AB%E3%82%88%E3%82%8B%E7%95%B3%E3%81%BF%E8%BE%BC%E3%81%BF",
            "import numpy as np",
            "def convolve(f, g):",
            "    \"\"\"多項式 f, g の積を計算する。",
            "",
            "    Parameters",
            "    ----------",
            "    f : np.ndarray (int64)",
            "        f[i] に、x^i の係数が入っている",
            "",
            "    g : np.ndarray (int64)",
            "        g[i] に、x^i の係数が入っている",
            "",
            "",
            "    Returns",
            "    -------",
            "    h : np.ndarray",
            "        f,g の積",
            "    \"\"\"",
            "    # h の長さ以上の n=2^k を計算",
            "    fft_len = 1",
            "    while 2 * fft_len < len(f) + len(g) - 1:",
            "        fft_len *= 2",
            "    fft_len *= 2",
            "",
            "    # フーリエ変換",
            "    Ff = np.fft.rfft(f, fft_len)",
            "    Fg = np.fft.rfft(g, fft_len)",
            "",
            "    # 各点積",
            "    Fh = Ff * Fg",
            "",
            "    # フーリエ逆変換",
            "    h = np.fft.irfft(Fh, fft_len)",
            "",
            "    # 小数になっているので、整数にまるめる",
            "    h = np.rint(h).astype(np.int64)",
            "",
            "    return h[:len(f) + len(g) - 1]",
        ],
        "description": ""
    },
    "GAME_DP": {
        "prefix": "GAME_DP",
        "body": [
            "########### 移動方法の取得 ###########",
            "def get_move(maps):",
            "    ret = []",
            "    for y in range(3):",
            "        for x in range(3):",
            "            if maps[y][x]==0:",
            "                ret.append((y,x))",
            "    return ret",
            "",
            "########### 勝敗判定(ゲーム終了条件)の取得 ###########",
            "def check_winner(maps):",
            "    global A",
            "    if BINGO(maps):",
            "        return True",
            "    ",
            "    AOKI = 0",
            "    TAKAHASHI = 0",
            "    zero_count = 0",
            "    for y in range(3):",
            "        for x in range(3):",
            "            if maps[y][x]==1:",
            "                TAKAHASHI += A[y][x]",
            "            elif maps[y][x] == -1:",
            "                AOKI += A[y][x]",
            "            else:",
            "                zero_count += 1",
            "    if zero_count == 0:",
            "        return True    ",
            "    return False",
            "",
            "def calc(maps, now):",
            "    global A",
            "    AOKI = 0",
            "    TAKAHASHI = 0",
            "    zero_count = 0",
            "    for y in range(3):",
            "        for x in range(3):",
            "            if maps[y][x]==1:",
            "                TAKAHASHI += A[y][x]",
            "            elif maps[y][x] == -1:",
            "                AOKI += A[y][x]",
            "            else:",
            "                zero_count += 1",
            "    ",
            "    if BINGO(maps):",
            "        return float(\"inf\")",
            "",
            "    if now==1:",
            "        return TAKAHASHI",
            "    else:",
            "        return AOKI",
            "",
            "# ゲーム木",
            "maps = [[0]*3 for _ in range(3)]",
            "",
            "def dfs(nokori, now):",
            "    global maps",
            "    ret = 0",
            "",
            "    # メモ済み判定",
            "    # if dp[nokori]!=-1:",
            "    #     return dp[nokori]",
            "",
            "    # 勝敗判定",
            "    temp = check_winner(maps)",
            "    if temp:",
            "        # print(maps, now)",
            "        return calc(maps, now)",
            "",
            "    # 移動方法取得",
            "    root = get_move(maps)",
            "",
            "    # 遷移する",
            "    for y,x in root:",
            "        # dfs(n-a) によって、相手視点の得点が得られるので、これを n から引く",
            "        # ret = max(ret, nokori - dfs(nokori-a)) ## 最大が決まってて、そこから引いていくタイプはこっち？",
            "",
            "        maps[y][x] = now",
            "        ret = max(ret, nokori - dfs(nokori-A[y][x], now*-1))",
            "        maps[y][x] = 0",
            "    return ret",
            "",
        ],
        "description": ""
    },


