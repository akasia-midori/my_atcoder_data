    "treap": {
        "prefix": "treap",
        "body": [
            "from random import randint",
            "class node:",
            "    def __init__(self, v, p):",
            "        self.val = v # 値",
            "        self.ch = [None, None] # [左, 右]",
            "        self.pri = p # 優先度",
            "        self.cnt = 1 # 部分木のサイズ",
            "        self.sums = v # 部分木の値の和",
            "",
            "class treap:",
            "    from random import randint",
            "    def __init__(self):",
            "        self.tree = None",
            "",
            "",
            "    def count_node(self, t):",
            "        if t is None:",
            "            return 0",
            "        return t.cnt",
            "",
            "    def sum_node(self, t):",
            "        if t is None:",
            "            return 0",
            "        return t.sums",
            "",
            "    def update(self, t):",
            "        t.cnt = self.count_node(t.ch[0]) + self.count_node(t.ch[1]) + 1",
            "        t.sums = self.sum_node(t.ch[0]) + self.sum_node(t.ch[1]) + t.val",
            "        return t",
            "",
            "    #参考: https://www.slideshare.net/iwiwi/2-12188757",
            "    # 左の木 l , 右の木 r",
            "    def merge(self, l, r):",
            "        # 優先度の高い方の根を新しい根にする",
            "        # 再帰的にmerge  ← 再帰的?! pythonを殺す気か?!",
            "        ",
            "        # どちらかがNULLならNULLじゃない方を返す",
            "        if l is None:",
            "            return r",
            "        elif r is None:",
            "            return l",
            "        ",
            "        # 左の部分木の根の方が優先度が高い場合",
            "        if l.pri > r.pri:",
            "            l.ch[1] = self.merge(l.ch[1], r)",
            "            return self.update(l)",
            "        ",
            "        # 右の部分木の根の方が優先度が高い場合",
            "        else:",
            "            r.ch[0] = self.merge(l, r.ch[0])",
            "            return self.update(r)",
            "",
            "    def split(self, t, k):",
            "        # splitは優先度のことをを何も考えないで再帰的に切るだけ ← 再帰的?!",
            "        # (部分木内の任意のノードは根より優先度小なので大丈夫)",
            "        if t is None:",
            "            return (None, None)",
            "        ",
            "        if k <= self.count_node(t.ch[0]):",
            "            s = self.split(t.ch[0], k)",
            "            t.ch[0] = s[1]",
            "            return (s[0], self.update(t))",
            "        else:",
            "            s = self.split(t.ch[1], k - self.count_node(t.ch[0]) -1)",
            "            t.ch[1] = s[0]",
            "            return (self.update(t), s[1])    ",
            "",
            "    # 木 t, 場所 k, 値 v",
            "    def insert(self, k, v):",
            "        # 木tを場所kでsplit",
            "        t = self.tree",
            "        # 左の部分木、値vのノードだけの木、右の部分木をmerge",
            "        l, r = self.split(t, k)",
            "        n = node(v, randint(0,10**8))",
            "        ",
            "        temp = self.merge(l,n)",
            "        temp1 = self.merge(temp, r)",
            "        self.tree = temp1",
            "        # return temp1",
            "",
            "    # 木 t, 場所 k",
            "    def erase(self, k):",
            "        t = self.tree",
            "        # 木tを場所kと場所k+1で3つにsplit (split2回やればいい)",
            "        # 一番左と一番右の部分木をmerge",
            "        l1, r1 = self.split(t, k)",
            "        _, r2 = self.split(r1, k+1 - self.count_node(l1))",
            "        self.tree = self.merge(l1, r2)",
            "",
            "    # 探す木 t, 何番目かを示す k",
            "    # k番目に1が立ってる位置を探して返す",
            "    def searchK(self, k):",
            "        t = self.tree",
            "        # 1足ってる数がk以下ならNoneを返す。そんなのないので",
            "        if self.sum_node(t) < k:",
            "            return None",
            "        # ",
            "        index = 0",
            "",
            "        now = t",
            "        while True:",
            "            if now is None:",
            "                break",
            "",
            "            #",
            "            part_sums_l = self.sum_node(now.ch[0])",
            "            sums_l = part_sums_l + now.val # 自分自身を含めた左側の部分木の立ってるbitの数",
            "",
            "            # 両方子供がいない。つまり葉であるなら",
            "            if now.ch[0] is None and now.ch[1] is None:  break",
            "            ",
            "            # 左が既に超えてたら左のindexへ行く",
            "            if sums_l >= k:",
            "                # 自分のノードを含めないとkに足りない時 ",
            "                if part_sums_l < k:",
            "                    # 今までの累計のindexと左側の部分木と自分自身を足して返す",
            "                    # print(index, count_node(now.ch[0]))",
            "                    return index + (self.count_node(now.ch[0]))",
            "",
            "                now = now.ch[0]",
            "",
            "            # ここに来るのは左が超えていない状態 ",
            "            else: ",
            "                index += (self.count_node(now.ch[0])+1)",
            "                now = now.ch[1]",
            "                k -= sums_l",
            "            ",
            "",
            "        return index",
            "",
            "    # 0 ~ index-1までの1の数を返す関数",
            "    def get_acc_one(self, index):",
            "        t = self.tree",
            "",
            "        if self.count_node(t) < index:",
            "            return 0",
            "        ",
            "        # 閉区間に対応させる",
            "        # index -= 1",
            "        one_num = 0",
            "",
            "        now = t",
            "        while True:",
            "            if now is None:",
            "                break",
            "",
            "            #",
            "            part_nodes_l = self.count_node(now.ch[0])",
            "            nodes_l = part_nodes_l + 1 # 自分自身を含めた左側の部分木のnodeの数",
            "",
            "            # 終了条件",
            "            # if nodes_l == index:  break",
            "            ",
            "            # 左が既に超えてたら左のindexへ行く",
            "            if nodes_l >= index:",
            "                # 自分のノードを含めないとkに足りない時 ",
            "                if part_nodes_l < index:",
            "                    # 今までの累計のindexと左側の部分木と自分自身を足して返す",
            "                    # print(index, count_node(now.ch[0]))",
            "                    return one_num + (self.sum_node(now.ch[0])) + now.val",
            "",
            "                now = now.ch[0]",
            "",
            "            # ここに来るのは左が超えていない状態 ",
            "            else: ",
            "                one_num += (self.sum_node(now.ch[0]) + now.val)",
            "                now = now.ch[1]",
            "                index -= nodes_l",
            "            ",
            "",
            "        return index",
            "",
            "",
            "",
            "    # 0 ~ index-1までの0の数を返す関数",
            "    def get_acc_zero(self, index):",
            "        temp = self.get_acc_one(index)",
            "        if temp is None:",
            "            return None",
            "        return index - self.get_acc_one(index)",
            "",
        ],
        "description": ""
    },
