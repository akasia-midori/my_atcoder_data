            "                one_num = self.matrix[i][r] - self.matrix[i][l]",
            "                if zero_num != 0:",
            "                    r1 = self.matrix_zero[i][r]",
            "                    l1 = self.matrix_zero[i][l]",
            "                    if i == (self.bit_length-1):",
            "                        heapq.heappush(q2, (-1*(r1-l1), num))",
            "                    else:",
            "                        q2.append((r1-l1, l1, num))",
            "",
            "                if one_num != 0:",
            "                    r2 = self.zero_count[i] + self.matrix[i][r]",
