    "NIJIGEN_RUISEKIWA": {
        "prefix": "NIJIGEN_RUISEKIWA",
        "body": [
            "class CumulativeSum2D:",
            "    #累積和テーブルを作成する",
            "    def __init__(self, S) -> None:",
            "        '''",
            "        S:累積前の元のテーブル",
            "        '''",
            "        self.H=len(S)",
            "        self.W=len(S[0])",
            "        self.S=S",
            " ",
            "        #一番上と一番左は０の累積和テーブルを作成する。",
            "        # self.cum=[[0]*(self.W+1) for _ in range(self.H+1)]",
            "        self.cum=[0]*((self.W+1)*(self.H+1))",
            "",
            "        for h in range(self.H):",
            "            for w in range(self.W):",
            "                self.cum[(h+1)*(self.W+1)+w+1] = self.cum[(h+1)*(self.W+1)+w] + self.cum[h*(self.W+1)+w+1]-self.cum[h*(self.W+1)+w]+self.S[h][w]",
            "                # self.cum[h+1][w+1]=self.cum[h+1][w]+self.cum[h][w+1]-self.cum[h][w]+self.S[h][w]",
            " ",
            "    #指定した範囲の累積和を取る",
            "    def sum(self, h1, w1, h2, w2):",
            "        '''",
            "        h1:右下の座標の縦方向の位置。3個目なら3",
            "        w1:右下の座標の横方向の位置。3個目なら3",
            "        h2:左上の座標の縦方向の位置。3個目なら3",
            "        w2:左上の座標の横方向の位置。3個目なら3",
            "        '''",
            "        # return self.cum[h1][w1]-self.cum[h1][w2]-self.cum[h2][w1]+self.cum[h2][w2]",
            "        return self.cum[(h1)*(self.W+1)+w1]-self.cum[(h1)*(self.W+1)+w2]-self.cum[(h2)*(self.W+1)+w1]+self.cum[(h2)*(self.W+1)+w2]",
            "      ",
            "# 左上の(sx,sy), 右上の(tx,ty)",
            "def get_2D_acc(sx,sy, tx, ty):",
            "    alls = maps[ty][tx]",
            "    diff1 = maps[ty][sx-1]",
            "    diff2 = maps[sy-1][tx]",
            "    add = maps[sy-1][sx-1]",
            "    return alls - diff1 - diff2 + add",
        ],
