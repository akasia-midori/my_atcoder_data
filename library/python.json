            "        num = l - self.get_start_index(out)+k #self.start_dict[out] + k",
            "        return out, num",
            "",
            "        # #テストコード",
            "        # from random import randint",
            "        # N = 10**3",
            "        # A = [randint(1,100) for _ in range(N)]",
            "        # WM = WaveletMatrix(A)",
            "",
            "        # for i in range(100):",
            "        #     l = randint(0,N-1)",
