            "    # indexは終端(半開区間)",
            "    # num個目のvalueがどのindexにあったかを取得",
            "    # ナイーブにやるなら値をキーとした配列にindex入れてそれで取る",
            "    def select(self, value, num):",
            "        if value not in self.count_dict: # 最初に与えられたAに存在しないときは0を返す",
