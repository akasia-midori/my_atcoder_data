            "        #     zero = temp_zero[:]",
            "        #     one = temp_one[:]",
            "        #     kari >>=1",
            "",
            "        # # 基数ソート後の並び順を取得",
            "        # c = 0",
            "        # for x,a in zero:",
            "        #     if a not in self.start_dict:",
            "        #         self.start_dict[a] = c",
            "        #     c+=1",
