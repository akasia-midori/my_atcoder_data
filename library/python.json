            "        #             print(\"not same\")",
            "        #             break",
            "",
            "        # zeroの数の累積和を持っているがこれを1の累積和の行列で代替したい",
            "",
            "",
            "    # lからrの中でk番目に小さい値",
            "    def quantile(self, l, r, k):",
            "        out = 0",
            "        if (r-l) < k or k<=0:",
            "            return (None, None)",
            "",
            "        # print(zero_num, one_num)",
            "        for i in range(self.bit_length):",
            "            out <<= 1",
            "            # rは開区間, lは閉区間",
            "            # zero_num = self.matrix_zero[i][r] - self.matrix_zero[i][l]",
            "            # one_num = self.matrix[i][r] - self.matrix[i][l]",
            "            zero_num = self.matrix[i].get_acc_zero(r) - self.matrix[i].get_acc_zero(l)",
            "            one_num = self.matrix[i].get_acc_one(r) - self.matrix[i].get_acc_one(l)",
            "",
            "            if zero_num < k <= zero_num+one_num: # bitが1なら",
            "                out += 1",
            "                l = self.zero_count[i] + (self.matrix[i].get_acc_one(l))",
            "                r = self.zero_count[i] + (self.matrix[i].get_acc_one(r))",
            "                k -= zero_num",
            "",
            "            else:",
            "                l = l - self.matrix[i].get_acc_one(l) #self.matrix[i][l]",
            "                r = r - self.matrix[i].get_acc_one(r) #self.matrix[i][r]",
            "",
            "            # print(out,k)",
            "            # print(f\"l:{l}, r:{r}, zero_num:{zero_num}, one_num:{one_num}\")",
