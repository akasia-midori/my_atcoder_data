            "# テンプレート変数",
            "q = deque([])",
            "",
            "for i, a in enumerate(A):",
            "    q.append(a)  ## dequeの\"右端\"に要素を一つ追加する。",
            "    # 共通処理",
            "    dicts[a] += 1",
            "",
            "    # 条件が満たされてない間の処理",
            "    while q and not (len(q) <= K): ## notの中に満たすべき条件を書く",
            "        rm = q.popleft() ## 条件を満たさないのでdequeの\"左端\"から要素を取り除く",
